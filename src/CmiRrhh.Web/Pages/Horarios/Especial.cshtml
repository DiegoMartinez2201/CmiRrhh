@page
@model CmiRrhh.Web.Pages.Horarios.EspecialModel
@{
    ViewData["Title"] = "Horario especial";
}

<div class="page-header">
    <h1>Horario especial</h1>
    <p class="page-subtitle">Asigna a un empleado un horario distinto por un rango de fechas, con referencia SISGEDO.</p>
</div>

@if (Model.MensajeOk is not null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.MensajeOk
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (Model.MensajeError is not null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Model.MensajeError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<form method="get" class="row g-3 align-items-end mb-4">
    <div class="col-md-3">
        <label asp-for="IdEmpleado" class="form-label"></label>
        <input asp-for="IdEmpleado" class="form-control" />
        <span asp-validation-for="IdEmpleado" class="text-danger"></span>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">Buscar</button>
    </div>
</form>

@if (Model.ConsultaEjecutada)
{
    <div class="card mb-4">
        <div class="card-header">Agregar horario especial</div>
        <div class="card-body">
            <form method="post" asp-page-handler="Agregar" class="row g-3">
                <input type="hidden" asp-for="IdEmpleado" />
                <div class="col-md-4">
                    <label asp-for="Nuevo.IdHorario" class="form-label"></label>
                    <select asp-for="Nuevo.IdHorario" asp-items="Model.HorariosSelect" class="form-select">
                        <option value="">-- Seleccione --</option>
                    </select>
                    <span asp-validation-for="Nuevo.IdHorario" class="text-danger"></span>
                </div>
                <div class="col-md-2">
                    <label asp-for="Nuevo.FechaInicio" class="form-label"></label>
                    <input asp-for="Nuevo.FechaInicio" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Nuevo.FechaFin" class="form-label"></label>
                    <input asp-for="Nuevo.FechaFin" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Nuevo.NroDocumento" class="form-label"></label>
                    <input asp-for="Nuevo.NroDocumento" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Nuevo.Sisgedo" class="form-label"></label>
                    <input asp-for="Nuevo.Sisgedo" class="form-control" />
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">Agregar</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">Horarios especiales del empleado (@Model.Resultados.Count)</div>
        <div class="table-responsive">
            <table class="table table-sm table-striped table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Horario</th>
                        <th>Inicio</th>
                        <th>Fin</th>
                        <th>N° documento</th>
                        <th>SISGEDO</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fila in Model.Resultados)
                    {
                        <tr>
                            <td>@fila.DescripHorario</td>
                            <td>@(fila.FechaInicio?.ToString("dd/MM/yyyy"))</td>
                            <td>@(fila.FechaFin?.ToString("dd/MM/yyyy"))</td>
                            <td>@fila.NroDocumento</td>
                            <td>@fila.Sisgedo</td>
                            <td class="text-end">
                                <form method="post" asp-page-handler="Eliminar" asp-route-n="@fila.N" class="d-inline"
                                      onsubmit="return confirm('¿Eliminar este horario especial?');">
                                    <input type="hidden" asp-for="IdEmpleado" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (Model.Resultados.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-3">Este empleado no tiene horarios especiales registrados.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

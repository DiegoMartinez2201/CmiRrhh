@page "{id:int}"
@model CmiRrhh.Web.Pages.Personal.EscalafonariaImprimirModel
@{
    ViewData["Title"] = "Imprimir ficha escalafonaria";
}

<div class="no-print mb-3 d-flex gap-2">
    <button type="button" class="btn btn-primary" onclick="window.print()">Imprimir</button>
    <a asp-page="/Personal/Escalafonaria" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Volver a la ficha</a>
</div>

<div class="ficha-impresa">
    <h2 class="text-center mb-1">Ficha escalafonaria</h2>
    <p class="text-center text-muted">Emitida el @DateTime.Today.ToString("dd/MM/yyyy")</p>

    @foreach (var b in Model.Bloques)
    {
        if (b.EsSubbloque)
        {
            <h6 class="mt-3 text-uppercase">@b.Titulo</h6>
        }
        else
        {
            <h5 class="mt-4 text-uppercase">@b.Titulo</h5>
        }

        <table class="table table-sm table-bordered">
            <tbody>
                @for (var i = 0; i < b.Campos.Count; i += 2)
                {
                    <tr>
                        <th style="width:22%">@b.Campos[i].Etiqueta</th>
                        @if (i + 1 < b.Campos.Count)
                        {
                            <td style="width:28%">@b.Campos[i].Valor</td>
                            <th style="width:22%">@b.Campos[i + 1].Etiqueta</th>
                            <td style="width:28%">@b.Campos[i + 1].Valor</td>
                        }
                        else
                        {
                            <td colspan="3">@b.Campos[i].Valor</td>
                        }
                    </tr>
                }
            </tbody>
        </table>

        @if (b.Tabla is not null)
        {
            <h6>@b.Tabla.Titulo</h6>
            <table class="table table-sm table-bordered">
                <thead><tr>@foreach (var c in b.Tabla.Columnas) { <th>@c</th> }</tr></thead>
                <tbody>
                    @foreach (var fila in b.Tabla.Filas)
                    {
                        <tr>@foreach (var celda in fila) { <td>@celda</td> }</tr>
                    }
                    @if (b.Tabla.Filas.Count == 0)
                    {
                        <tr><td colspan="@b.Tabla.Columnas.Count" class="text-center text-muted">Sin registros.</td></tr>
                    }
                </tbody>
            </table>
        }
    }

    <h5 class="mt-4 text-uppercase">V. Aspecto de educación y trayectoria del trabajador</h5>

    @foreach (var (seccion, filas) in Model.Secciones)
    {
        var campos = seccion.Campos.Where(c => c.EnLista).ToList();
        <h5 class="mt-4">@seccion.Titulo</h5>
        <table class="table table-sm table-bordered">
            <thead>
                <tr>
                    @foreach (var c in campos)
                    {
                        <th>@c.Etiqueta</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var f in filas)
                {
                    <tr>
                        @foreach (var c in campos)
                        {
                            <td>@(f.Visibles.TryGetValue(c.Clave, out var t) ? t : string.Empty)</td>
                        }
                    </tr>
                }
                @if (filas.Count == 0)
                {
                    <tr><td colspan="@Math.Max(campos.Count, 1)" class="text-center text-muted">Sin registros.</td></tr>
                }
            </tbody>
        </table>
    }
</div>

<style>
    @@media print {
        .no-print, .sidebar, .topbar { display: none !important; }
        h5 { break-after: avoid; }
        table { break-inside: auto; }
        tr { break-inside: avoid; }
    }
</style>

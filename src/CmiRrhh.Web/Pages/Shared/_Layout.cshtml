@{
    var currentPage = ViewContext.RouteData.Values["page"] as string ?? string.Empty;
    bool EsActual(string pagina) => string.Equals(currentPage, pagina, StringComparison.OrdinalIgnoreCase);
    var autenticado = User.Identity?.IsAuthenticated == true;
    var puedeVerAsistencias = autenticado
        && (User.IsInRole(AuthConstants.RolAsistencias)
            || User.IsInRole(AuthConstants.RolAsistenciasCas)
            || User.IsInRole(AuthConstants.RolReportesAsistencias));
    var puedeEditarAsistencias = autenticado
        && (User.IsInRole(AuthConstants.RolAsistencias) || User.IsInRole(AuthConstants.RolAsistenciasCas));
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CMI RRHH</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CmiRrhh.Web.styles.css" asp-append-version="true" />
</head>
<body>
@if (autenticado)
{
    <div class="app-shell">
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
        <aside class="app-sidebar" id="appSidebar">
            <a class="brand" asp-page="/Index">
                <span class="logo-dot"></span>
                <span>CMI RRHH</span>
            </a>
            <nav>
                <div class="sidebar-section-title">General</div>
                <a class="sidebar-link @(EsActual("/Index") ? "active" : "")" asp-page="/Index">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11.5 12 4l9 7.5" /><path d="M5 10v9a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1v-9" /></svg>
                    <span>Inicio</span>
                </a>

                @if (puedeVerAsistencias)
                {
                    <div class="sidebar-section-title">Asistencias</div>
                    <a class="sidebar-link @(EsActual("/Asistencias/Consulta") ? "active" : "")" asp-page="/Asistencias/Consulta">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.2 2" /></svg>
                        <span>Consulta</span>
                    </a>
                    <a class="sidebar-link @(EsActual("/Asistencias/Planilla") ? "active" : "")" asp-page="/Asistencias/Planilla">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="3.5" width="7" height="7" rx="1.2" /><rect x="13.5" y="3.5" width="7" height="7" rx="1.2" /><rect x="3.5" y="13.5" width="7" height="7" rx="1.2" /><rect x="13.5" y="13.5" width="7" height="7" rx="1.2" /></svg>
                        <span>Planilla</span>
                    </a>
                    @if (puedeEditarAsistencias)
                    {
                        <a class="sidebar-link @(EsActual("/Asistencias/Correccion") ? "active" : "")" asp-page="/Asistencias/Correccion">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                            <span>Corrección</span>
                        </a>
                        <a class="sidebar-link @(EsActual("/Asistencias/ImportarBiometrico") ? "active" : "")" asp-page="/Asistencias/ImportarBiometrico">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4" /><path d="M7 9l5-5 5 5" /><path d="M4 16v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" /></svg>
                            <span>Importar bio</span>
                        </a>
                        <a class="sidebar-link @(EsActual("/Asistencias/MarcacionesAutorizadas") ? "active" : "")" asp-page="/Asistencias/MarcacionesAutorizadas">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3 7-7" /><path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9" /></svg>
                            <span>Marc. autorizadas</span>
                        </a>
                        <a class="sidebar-link @(EsActual("/Asistencias/SuspenderAsistencia") ? "active" : "")" asp-page="/Asistencias/SuspenderAsistencia">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M8.5 8.5l7 7M15.5 8.5l-7 7" /></svg>
                            <span>Suspender asistencia</span>
                        </a>
                    }
                }

                @if (puedeVerAsistencias)
                {
                    <div class="sidebar-section-title">Permisos</div>
                    <a class="sidebar-link @(EsActual("/Permisos/Consulta") ? "active" : "")" asp-page="/Permisos/Consulta">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="5" width="16" height="16" rx="2" /><path d="M8 3v4M16 3v4M4 10h16" /></svg>
                        <span>Consulta</span>
                    </a>
                    @if (puedeEditarAsistencias)
                    {
                        <a class="sidebar-link @(EsActual("/Permisos/Registro") ? "active" : "")" asp-page="/Permisos/Registro">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="5" width="16" height="16" rx="2" /><path d="M8 3v4M16 3v4M4 10h16" /><path d="M12 14v4M10 16h4" /></svg>
                            <span>Nuevo permiso</span>
                        </a>
                    }
                }

                @if (puedeVerAsistencias)
                {
                    <div class="sidebar-section-title">Personal</div>
                    <a class="sidebar-link @(EsActual("/Personal/Index") ? "active" : "")" asp-page="/Personal/Index">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2" /><path d="M3 20a6 6 0 0 1 12 0" /><circle cx="17.5" cy="9" r="2.4" /><path d="M16 14.2a5 5 0 0 1 5 5.8" /></svg>
                        <span>Relación / búsqueda</span>
                    </a>
                    @if (puedeEditarAsistencias)
                    {
                        <a class="sidebar-link @(EsActual("/Personal/Asignar") ? "active" : "")" asp-page="/Personal/Asignar">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M8 9h8M8 13h8M8 17h5" /></svg>
                            <span>Asignar horario / local</span>
                        </a>
                    }
                    <a class="sidebar-link @(EsActual("/Estructura/Index") ? "active" : "")" asp-page="/Estructura/Index">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="3" width="6" height="5" rx="1" /><rect x="3" y="16" width="6" height="5" rx="1" /><rect x="15" y="16" width="6" height="5" rx="1" /><path d="M12 8v4M6 16v-4h12v4" /></svg>
                        <span>Estructura orgánica</span>
                    </a>
                }

                @if (puedeVerAsistencias)
                {
                    <div class="sidebar-section-title">Reportes</div>
                    <a class="sidebar-link @(EsActual("/Reportes/Index") ? "active" : "")" asp-page="/Reportes/Index">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l4 4v14H6z" /><path d="M14 3v5h5M9 13h7M9 17h7" /></svg>
                        <span>Personal</span>
                    </a>
                }

                @if (puedeEditarAsistencias)
                {
                    <div class="sidebar-section-title">Mantenimientos</div>
                    <a class="sidebar-link @(EsActual("/Mantenimientos/Index") ? "active" : "")" asp-page="/Mantenimientos/Index">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h10" /></svg>
                        <span>Catálogos</span>
                    </a>
                }

                @if (puedeEditarAsistencias)
                {
                    <div class="sidebar-section-title">Horarios</div>
                    <a class="sidebar-link @(EsActual("/Horarios/Index") ? "active" : "")" asp-page="/Horarios/Index">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7.5v4.8l3.5 2" /></svg>
                        <span>Horarios</span>
                    </a>
                    <a class="sidebar-link @(EsActual("/Horarios/Especial") ? "active" : "")" asp-page="/Horarios/Especial">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="4" width="17" height="16" rx="2" /><path d="M3.5 9.5h17" /><path d="M8 3v3M16 3v3" /><path d="M12 13l1.6 1.6L16 12" /></svg>
                        <span>Horario especial</span>
                    </a>
                    <a class="sidebar-link @(EsActual("/Horarios/Feriados") ? "active" : "")" asp-page="/Horarios/Feriados">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="4" width="17" height="16" rx="2" /><path d="M3.5 9.5h17" /><path d="M8 3v3M16 3v3" /><circle cx="12" cy="15" r="1.4" /></svg>
                        <span>Feriados</span>
                    </a>
                }
            </nav>
            <div class="sidebar-footer">
                Sistema RRHH · migración web
            </div>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-label="Abrir menú">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
                </button>
                <p class="page-title">@ViewData["Title"]</p>
                <div class="spacer"></div>
                <div class="user-chip">
                    <span class="avatar">@(User.Identity!.Name is { Length: > 0 } nombre ? nombre.Substring(0, 1).ToUpperInvariant() : "?")</span>
                    <span class="d-none d-sm-inline">@User.Identity.Name</span>
                </div>
                <form asp-page="/Account/Logout" method="post" class="d-inline ms-2">
                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="Salir">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><path d="M16 17l5-5-5-5" /><path d="M21 12H9" /></svg>
                    </button>
                </form>
            </header>
            <main class="app-content" role="main">
                @RenderBody()
            </main>
            <footer class="app-footer">&copy; 2026 - CMI RRHH</footer>
        </div>
    </div>
}
else
{
    <div class="guest-topbar">
        <div class="container">
            <a class="brand" asp-page="/Index">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11.5 12 4l9 7.5" /><path d="M5 10v9a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1v-9" /></svg>
                <span>CMI RRHH</span>
            </a>
        </div>
    </div>
    <div class="guest-main">
        <div class="container">
            @RenderBody()
        </div>
    </div>
    <footer class="app-footer">&copy; 2026 - CMI RRHH</footer>
}

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            var sidebar = document.getElementById('appSidebar');
            var toggle = document.getElementById('sidebarToggle');
            var backdrop = document.getElementById('sidebarBackdrop');
            if (!sidebar || !toggle || !backdrop) { return; }

            function abrir() {
                sidebar.classList.add('show');
                backdrop.classList.add('show');
            }
            function cerrar() {
                sidebar.classList.remove('show');
                backdrop.classList.remove('show');
            }

            toggle.addEventListener('click', function () {
                sidebar.classList.contains('show') ? cerrar() : abrir();
            });
            backdrop.addEventListener('click', cerrar);
            sidebar.querySelectorAll('a.sidebar-link').forEach(function (link) {
                link.addEventListener('click', function () {
                    if (window.innerWidth < 992) { cerrar(); }
                });
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

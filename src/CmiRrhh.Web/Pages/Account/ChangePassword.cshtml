@page
@model CmiRrhh.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm mt-4">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Cambiar contraseña</h1>

                @if (!string.IsNullOrEmpty(Model.InfoMessage))
                {
                    <div class="alert alert-warning" role="alert">@Model.InfoMessage</div>
                }

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="NuevaPassword" class="form-label"></label>
                        <input asp-for="NuevaPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="NuevaPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Confirmacion" class="form-label"></label>
                        <input asp-for="Confirmacion" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Confirmacion" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Guardar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

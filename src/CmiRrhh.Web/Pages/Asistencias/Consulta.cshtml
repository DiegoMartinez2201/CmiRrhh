@page
@model CmiRrhh.Web.Pages.Asistencias.ConsultaModel
@{
    ViewData["Title"] = "Consulta de asistencias";
}

<h1 class="h3 mb-3">Consulta de asistencias</h1>
<p class="text-muted">Equivalente a FrmConsultaAsistencias: listado por rango de fechas.</p>

<form method="get" class="row g-3 align-items-end mb-4">
    <div class="col-md-3">
        <label asp-for="FechaInicio" class="form-label"></label>
        <input asp-for="FechaInicio" class="form-control" />
        <span asp-validation-for="FechaInicio" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="FechaFin" class="form-label"></label>
        <input asp-for="FechaFin" class="form-control" />
        <span asp-validation-for="FechaFin" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary">Consultar</button>
    </div>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
</form>

@if (Model.ConsultaEjecutada)
{
    <p class="small text-muted mb-2">@Model.Resultados.Count registro(s).</p>
    @if (Model.Resultados.Count == 0)
    {
        <div class="alert alert-info">No hay registros de asistencia en el rango indicado.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Id</th>
                        <th>Empleado</th>
                        <th>Documento</th>
                        <th>Área</th>
                        <th>Estado</th>
                        <th>Ingreso</th>
                        <th>Salida</th>
                        <th>Min. tarde</th>
                        <th>Min. normales</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fila in Model.Resultados)
                    {
                        <tr>
                            <td>@fila.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@fila.IdEmpleado</td>
                            <td>@fila.NombresCompletos</td>
                            <td>@fila.NumDocId</td>
                            <td>@fila.AreaOrganizacional</td>
                            <td>@fila.Estado</td>
                            <td>@fila.HorEnt</td>
                            <td>@fila.HorSal</td>
                            <td>@fila.MinTarde</td>
                            <td>@fila.MinNormales</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
